run = "python3 app.py"
modules = ["python-3.12", "web", "nodejs-24"]

[nix]
channel = "stable-25_05"
packages = ["gitFull", "playwright-driver"]

[userenv]

[userenv.shared]

[deployment]
deploymentTarget = "cloudrun"
build = "npm ci --omit=dev --omit=optional --no-audit --no-fund"
run = "python3 app.py"

[[ports]]
localPort = 5000
externalPort = 80

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Local Quote Desk"

[[workflows.workflow]]
name = "Local Quote Desk"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "python3 app.py"

[workflows.workflow.metadata]
outputType = "console"

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 180000
